POSTGRES_USER=prana
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=prana

# Comma-separated slug:token pairs auto-created on startup
BOOTSTRAP_USERS=hemin:change_me_hemin_ingest_token

# Required for POST /api/v1/users (creating additional household users at runtime)
ADMIN_TOKEN=change_me_admin_secret_token

TZ=America/Los_Angeles
BACKUP_CRON_HOUR=3
BACKUP_RETENTION_DAYS=30

# Phase 1B: Oura Ring 4 BLE sync (--profile oura)
OURA_INGEST_TOKEN=change_me_hemin_ingest_token
OURA_DEVICE_NAME=Oura Ring 4
OURA_SYNC_INTERVAL_SEC=3600
